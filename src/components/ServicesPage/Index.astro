---
import { AppConfig } from "@/data/app.config";
import CTA from '@/components/CTA.astro';
import SectionTitle from "@/components/ui/SectionTitle.astro";
---

<main class="ServicesPage">
    <section class="Services">
        <div class="container-fluid">
            <SectionTitle 
                title="Services"
                description="Every project starts with one question: what outcome are you actually trying to achieve? We build infrastructure that answers that - not software that ticks a feature list."
            />

            <div class="services-wrapper grid lg:grid-cols-2 gap-8">
                {AppConfig.services.map((service, index) => (
                    <div class="service space-y-2 p-2 bg-highlight rounded-lg flex flex-col">
                        <div class="image-wrapper w-full h-[30dvh] lg:h-[40dvh] relative bg-accent p-1 rounded-lg">
                            <div class="image w-full h-full rounded-lg overflow-hidden">
                                <img src={service.image.src} alt={service.name} class="h-full w-full object-cover" />
                            </div>
                        </div>

                        <div class="content p-4 space-y-4 flex-1">
                            <div class="info space-y-2">
                                <p class="font-bold">{String(index + 1).padStart(2, '0')}. {service.name}</p>
                                <p>{service.description}</p>
                            </div>

                            <div class="pills">
                                {service.tags.map((tag, tagIndex) => (
                                    <span>{tag}</span>
                                ))}
                            </div>
                        </div>

                        <div class="actions px-4 py-2">
                            <a href={`/services/${service.slug}`} class="inline-block bg-accent text-accent-foreground py-2 px-4 rounded-sm font-medium">Service Info</a>
                        </div>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <CTA />
</main>