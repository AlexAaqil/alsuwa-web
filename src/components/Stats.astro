---
import { AppConfig } from "@/data/app.config";
---

<section class="BrandStats">
    <div class="container-fluid">
        <div class="stats grid grid-cols-2 lg:grid-cols-4 gap-8 rounded-lg">
            <div class="stat grid gap-2 p-4 lg:text-center lg:border-r lg:border-border">
                <span class="text-l-text font-bold">{AppConfig.stats.years_of_experience}</span>
                <span>Years Experience</span>
            </div>

            <div class="stat grid gap-2 p-4 lg:text-center lg:border-r lg:border-border">
                <span class="text-l-text font-bold">{AppConfig.stats.projects}</span>
                <span>Projects Shipped</span>
            </div>

            <div class="stat grid gap-2 p-4 lg:text-center lg:border-r lg:border-border">
                <span class="text-l-text font-bold">{AppConfig.stats.client_satisfaction}</span>
                <span>Client Satisfaction</span>
            </div>

            <div class="stat grid gap-2 p-4 lg:text-center">
                <span class="text-l-text font-bold">{AppConfig.stats.client_ROI}</span>
                <span>Avg. Client ROI</span>
            </div>
        </div>
    </div>
</section>