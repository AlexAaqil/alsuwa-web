---
import MainLayout from '@/layouts/MainLayout.astro';
---

<MainLayout
    title="Alsuwa Software"
    description="Explore our list of custom software demos"
>
    <section class="Hero">
        <div class="container-fluid">
            <h1 class="text-center font-bold mb-12 text-heading-text lg:text-l-text">Sofware Demos</h1>

            <div class="software grid lg:grid-cols-4 gap-12">
                <a href="https://ecommerce.alsuwa.com" target="_blank" rel="noopener noreferrer" class="software py-4 px-6 border border-border rounded-lg text-center block hover:bg-accent/10 transition-colors">Ecommerce</a>

                <a href="https://pos.alsuwa.com" target="_blank" rel="noopener noreferrer" class="software py-4 px-6 border border-border rounded-lg text-center block hover:bg-accent/10 transition-colors">POS</a>

                <a href="https://erp.alsuwa.com" target="_blank" rel="noopener noreferrer" class="software py-4 px-6 border border-border rounded-lg text-center block hover:bg-accent/10 transition-colors">ERP</a>

                <a href="https://hrms.alsuwa.com" target="_blank" rel="noopener noreferrer" class="software py-4 px-6 border border-border rounded-lg text-center block hover:bg-accent/10 transition-colors">HRMS</a>
            </div>
        </div>
    </section>
</MainLayout>